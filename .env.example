# =============================================
# BUSINESS ASSISTANT — Environment Variables
# Copy to .env and fill in your values
# ALL services below have FREE tiers
# =============================================

# === Django ===
# Generate with: python -c "import secrets; print(secrets.token_hex(50))"
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET_KEY
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com,api.your-domain.com
DJANGO_SETTINGS_MODULE=config.settings.production
ENVIRONMENT=production

# === Database (PostgreSQL Required) ===
# PostgreSQL required for all environments (no SQLite fallback)
# Local dev: Create database with: createdb aeiou_dev
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/aeiou
DB_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD

# SSL required for production (auto-detected)

# === AI Models ===
# Gemini: https://aistudio.google.com (free, 1.5 Flash has 1M tokens/day)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY2=
GEMINI_API_KEY3=
GEMINI_API_KEY4=
# GEMINI_API_KEYS=comma,separated,gemini,keys
GEMINI_MODEL=gemini-2.0-flash
GEMINI_CHAT_ENABLED=False
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Groq: https://console.groq.com (free tier, very fast)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# NVIDIA NIM: https://build.nvidia.com (free hosted endpoints for prototyping)
NVIDIA_API_KEY=
NVIDIA_MODEL=moonshotai/kimi-k2.6

# OpenRouter: https://openrouter.ai (free models available)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

# === Search (optional) ===
# Brave Search: https://api.search.brave.com (free tier: 2000 queries/month)
BRAVE_SEARCH_API_KEY=your_brave_key_here

# === Redis (optional, for Celery) ===
# Upstash: https://upstash.com (free tier)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
GRAFANA_PASSWORD=REPLACE_WITH_STRONG_GRAFANA_PASSWORD

# === Timeouts (seconds) ===
GEMINI_TIMEOUT=15
GROQ_TIMEOUT=10
NVIDIA_TIMEOUT=20
OPENROUTER_TIMEOUT=20
MAX_TOOL_ITERATIONS=6

# === Document Processing ===
MAX_UPLOAD_SIZE_MB=10
CHUNK_SIZE_CHARS=1500
MAX_CHUNKS_PER_DOC=20

# === Security Settings (Production) ===
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# === Email Configuration ===
# For development: use console backend (prints to terminal)
# For production: use smtp backend with proper credentials
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Business Assistant <noreply@localhost>

# === Cloudflare R2 Storage (Optional - for production file storage) ===
# R2 free tier: 10GB storage, 1M requests/month
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com

# === Backup Storage (AWS S3 or Cloudflare R2) ===
# Used by django-dbbackup for automated daily backups
# Create S3 bucket or R2 bucket for backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_BUCKET=aeiou-backups
AWS_REGION=us-east-1

# === Frontend URL (for CORS and email links) ===
FRONTEND_URL=https://your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://api.your-domain.com

# === Production Operations ===
USE_S3=False
ENABLE_FILE_LOGGING=False
SENTRY_DSN=
